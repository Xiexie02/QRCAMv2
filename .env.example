# Set DB_DRIVER to mysql for offline XAMPP, or supabase for hosted Supabase.
DB_DRIVER=mysql

# MySQL / XAMPP
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=qrcam
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Supabase server key: use the Secret API key (sb_secret_...) or legacy service_role JWT.
# Never commit this server-side credential.
SUPABASE_URL=https://ejzlysntgphnizgiekui.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Adviser console login. Generate a hash with:
# php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_USERNAME=adviser
ADMIN_PASSWORD_HASH=

# Set to your local timezone, for example Asia/Manila.
APP_TIMEZONE=Asia/Manila
